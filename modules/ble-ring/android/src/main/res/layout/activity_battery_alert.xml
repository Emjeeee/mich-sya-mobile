<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/battery_alert_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:gravity="center"
  android:background="#e11d74"
  android:padding="32dp">

  <TextView
    android:id="@+id/battery_alert_icon"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="🔋"
    android:textSize="64sp"
    android:layout_marginBottom="16dp" />

  <TextView
    android:id="@+id/battery_alert_title"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Baterai HP kamu lemah"
    android:textColor="#ffffff"
    android:textSize="22sp"
    android:textStyle="bold"
    android:gravity="center"
    android:layout_marginBottom="8dp" />

  <TextView
    android:id="@+id/battery_alert_subtitle"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Yuk di-charge sebelum mati"
    android:textColor="#F0FFFFFF"
    android:textSize="15sp"
    android:gravity="center"
    android:layout_marginBottom="48dp" />

  <!-- Swipe-to-dismiss, styled to match the app's SwipeToConfirm component
       (src/components/SwipeToConfirm.tsx, e.g. "Geser untuk mulai kencan"):
       a white pill track with the label inside, and a pink circular knob
       with a white chevron that fades the label out as it's dragged. A
       plain SeekBar can't render that composited look on its own, so this
       layers a transparent-track SeekBar (thumb only) over a styled
       background + label. -->
  <FrameLayout
    android:id="@+id/battery_alert_swipe_container"
    android:layout_width="match_parent"
    android:layout_height="64dp">

    <View
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@drawable/battery_alert_track_bg" />

    <TextView
      android:id="@+id/battery_alert_swipe_label"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center"
      android:text="Geser buat matiin"
      android:textColor="#e11d74"
      android:textSize="15sp"
      android:textStyle="bold" />

    <!-- SeekBar positions its thumb by CENTER at the current progress, not
         by left edge like SwipeToConfirm's Animated.View. At progress=0
         that puts the thumb's center at the track's very start, so without
         enough padding here half the 56dp-wide thumb draws past the edge
         and gets clipped (looked like a cropped crescent instead of a full
         circle). paddingStart/End of ~half the thumb width (28dp) plus the
         same 4dp inset SwipeToConfirm itself uses reserves enough room for
         the whole thumb to render at both ends without clipping. -->
    <SeekBar
      android:id="@+id/battery_alert_dismiss_seekbar"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:max="100"
      android:progress="0"
      android:progressDrawable="@android:color/transparent"
      android:splitTrack="false"
      android:thumb="@drawable/battery_alert_thumb"
      android:paddingStart="32dp"
      android:paddingEnd="32dp" />

  </FrameLayout>

</LinearLayout>
