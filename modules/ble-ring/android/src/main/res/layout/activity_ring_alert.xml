<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/ring_alert_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:gravity="center"
  android:background="#e11d74"
  android:padding="32dp">

  <TextView
    android:id="@+id/ring_alert_icon"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="🔊"
    android:textSize="64sp"
    android:layout_marginBottom="16dp" />

  <TextView
    android:id="@+id/ring_alert_title"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="HP kamu lagi dibunyiin pasangan"
    android:textColor="#ffffff"
    android:textSize="22sp"
    android:textStyle="bold"
    android:gravity="center"
    android:layout_marginBottom="8dp" />

  <TextView
    android:id="@+id/ring_alert_subtitle"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Terdeteksi lewat Bluetooth, tanpa internet"
    android:textColor="#F0FFFFFF"
    android:textSize="15sp"
    android:gravity="center"
    android:layout_marginBottom="48dp" />

  <!-- Swipe-to-dismiss, same pattern/drawables as the battery alert
       (activity_battery_alert.xml); see NativeBatteryAlertActivity.kt for
       why a plain SeekBar needs the layered track+label+thumb setup and the
       extra thumb padding. No color-cycling background here though, per
       explicit request: just this static pink. -->
  <FrameLayout
    android:id="@+id/ring_alert_swipe_container"
    android:layout_width="match_parent"
    android:layout_height="64dp">

    <View
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@drawable/battery_alert_track_bg" />

    <TextView
      android:id="@+id/ring_alert_swipe_label"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center"
      android:text="Geser untuk hentikan"
      android:textColor="#e11d74"
      android:textSize="15sp"
      android:textStyle="bold" />

    <SeekBar
      android:id="@+id/ring_alert_dismiss_seekbar"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:max="100"
      android:progress="0"
      android:progressDrawable="@android:color/transparent"
      android:splitTrack="false"
      android:thumb="@drawable/battery_alert_thumb"
      android:paddingStart="32dp"
      android:paddingEnd="32dp" />

  </FrameLayout>

</LinearLayout>
