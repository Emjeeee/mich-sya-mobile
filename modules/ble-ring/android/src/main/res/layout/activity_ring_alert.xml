<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:gravity="center"
  android:background="#e11d74"
  android:padding="32dp">

  <TextView
    android:id="@+id/ring_alert_icon"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="🔊"
    android:textSize="64sp"
    android:layout_marginBottom="16dp" />

  <TextView
    android:id="@+id/ring_alert_title"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="HP kamu lagi dibunyiin pasangan"
    android:textColor="#ffffff"
    android:textSize="22sp"
    android:textStyle="bold"
    android:gravity="center"
    android:layout_marginBottom="8dp" />

  <TextView
    android:id="@+id/ring_alert_subtitle"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Terdeteksi lewat Bluetooth, tanpa internet"
    android:textColor="#F0FFFFFF"
    android:textSize="15sp"
    android:gravity="center"
    android:layout_marginBottom="48dp" />

  <Button
    android:id="@+id/ring_alert_stop_button"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:text="Hentikan"
    android:textColor="#e11d74"
    android:textStyle="bold"
    android:textSize="16sp"
    android:backgroundTint="#ffffff" />

</LinearLayout>
